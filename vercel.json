{
  "redirects": [
    {
      "source": "/product.html",
      "has": [
        { "type": "query", "key": "handle", "value": "the-ritual-bundle" }
      ],
      "destination": "/bundle.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/subscribe",
      "destination": "/api/subscribe.js"
    },
    {
      "source": "/api/wc/_healthcheck",
      "destination": "/api/wc-healthcheck.js"
    },
    {
      "source": "/api/wc/_stripe-config",
      "destination": "/api/wc-stripe-config.js"
    },
    {
      "source": "/api/wc/:path*",
      "destination": "/api/wc/[...path].js"
    }
  ]
}
